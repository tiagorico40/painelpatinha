<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script>
    async function fetchDoacoes() {
      const res = await fetch('/api/doacoes');
      const data = await res.json();
      const tbody = document.querySelector("#tabela-doacoes tbody");
      tbody.innerHTML = '';
      data.forEach(d => {
        const row = `<tr><td>${d.valor}</td><td>${d.data}</td><td>${d.hora}</td></tr>`;
        tbody.innerHTML += row;
      });
    }

    async function baixarTxt() {
      const res = await fetch('/api/doacoes/txt');
      const text = await res.text();
      const blob = new Blob([text], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'doacoes.txt';
      a.click();
      URL.revokeObjectURL(url);
    }

    setInterval(fetchDoacoes, 5000); // Atualiza a cada 5 segundos
    window.onload = fetchDoacoes;
  </script>
</head>
<body class="bg-white p-4">
  <h2 class="mb-4">Doações Recebidas</h2>
  <button class="btn btn-success mb-3" onclick="baixarTxt()">Baixar TXT</button>
  <table class="table table-striped" id="tabela-doacoes">
    <thead>
      <tr>
        <th>Valor</th>
        <th>Data</th>
        <th>Horário</th>
      </tr>
    </thead>
    <tbody>
      <!-- preenchido via JS -->
    </tbody>
  </table>
</body>
</html>